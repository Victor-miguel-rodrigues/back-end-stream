# ============================================
# Copie este arquivo para ".env" e preencha.
# NUNCA commite o .env (ele esta no .gitignore).
# ============================================

# Banco PostgreSQL (Supabase: Project Settings > Database > Connection string)
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Servidor local (na Vercel a porta e definida pela plataforma)
PORT=3000
NODE_ENV=development

# CORS - origens permitidas, separadas por virgula, sem espaco extra.
# Se vazio, usa a lista padrao de src/middlewares/cors.ts.
# localhost (qualquer porta) e *.vercel.app ja sao aceitos automaticamente.
CORS_ORIGINS=http://localhost:5500,http://localhost:3000

# Segredo do cron externo (header x-cron-secret) - rotas /admin/limpar-inativas.
# Obrigatorio apenas se voce chamar essa rota por um cron HTTP.
CRON_SECRET=troque-por-um-segredo-longo-e-aleatorio
